# Copy to keystore.properties (untracked) and fill in your own values.
# Generate the keystore with:
#
#   keytool -genkeypair -v \
#     -keystore glance-release.jks \
#     -alias glance \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Glance Kiosk, OU=Home, O=Glance, L=, S=, C=PL"
#
# Keep the .jks file and its passwords safe: an APK signed with a different key
# cannot be installed over an existing one without uninstalling first, which on a
# device-owner kiosk means a factory reset.
storeFile=glance-release.jks
storePassword=changeme
keyAlias=glance
keyPassword=changeme
