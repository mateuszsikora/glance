# Copy to keystore.properties (untracked) and fill in your own values.
# Generate the keystore with:
#
#   keytool -genkeypair -v \
#     -keystore glance-release.jks \
#     -alias glance \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Glance Kiosk, OU=Home, O=Glance, L=, S=, C=PL"
#
# IMPORTANT: configure a new release key before the very first install. An APK signed
# with a different key cannot update an existing Device Owner installation. If the
# tablet was provisioned from a debug APK, keep using and securely back up that exact
# ~/.android/debug.keystore instead of switching to a newly generated release key.
storeFile=glance-release.jks
storePassword=changeme
keyAlias=glance
keyPassword=changeme
