<?xml version="1.0" encoding="utf-8"?>
<!--
    Home Assistant is typically self-hosted on a LAN, reached over plain http://
    (e.g. http://homeassistant.local:8123). HTTPS still requires a certificate trusted by
    Android's system trust store; WebView rejects invalid and self-signed certificates.
    Since targetSdk 28, cleartext traffic is denied by default, which would break
    a dashboard WebView configured with a local http:// URL.

    This kiosk only ever talks to a user-configured HA instance on a trusted local
    network, so cleartext is permitted globally.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
