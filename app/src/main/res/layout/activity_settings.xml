<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FF1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Glance Settings"
            android:textSize="24sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Dashboard URLs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard URLs (one per line)"
            android:textColor="#FFB0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editDashboardUrls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine|textUri"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Auto-rotate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoRotate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto-rotate dashboards"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <EditText
            android:id="@+id/editAutoRotateInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rotate interval (seconds)"
            android:inputType="number"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Brightness -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brightness"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto brightness (light sensor)"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editMinBrightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Min (0-255)"
                android:inputType="number"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/editMaxBrightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Max (0-255)"
                android:inputType="number"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Screen Schedule -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Screen Schedule"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable schedule"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editScreenOnTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ON time (HH:mm)"
                android:inputType="time"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/editScreenOffTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="OFF time (HH:mm)"
                android:inputType="time"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- HA Integration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home Assistant"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchHaEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable HA integration"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editHaUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="HA URL (e.g. http://192.168.1.10:8123)"
            android:inputType="textUri"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editHaToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Long-Lived Access Token"
            android:inputType="textPassword"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editHaEntityScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Screen entity (e.g. input_boolean.tablet_screen)"
            android:inputType="text"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editHaEntityBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Brightness entity (e.g. input_number.tablet_brightness)"
            android:inputType="text"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Settings PIN -->
        <EditText
            android:id="@+id/editPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Settings PIN"
            android:inputType="numberPassword"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Debug Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debug Info"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textDebugInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Exit kiosk -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitKiosk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exit Kiosk Mode"
            android:textColor="#FFFF5252"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
