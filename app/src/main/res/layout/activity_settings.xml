<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FF1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Glance Settings"
            android:textSize="24sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Dashboard URLs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard URLs (one per line)"
            android:textColor="#FFB0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editDashboardUrls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine|textUri"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Auto-rotate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoRotate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto-rotate dashboards"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <EditText
            android:id="@+id/editAutoRotateInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rotate interval (seconds)"
            android:inputType="number"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Brightness -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brightness"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto brightness (light sensor)"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editMinBrightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Min (0-255)"
                android:inputType="number"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/editMaxBrightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Max (0-255)"
                android:inputType="number"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Screen Schedule -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Screen ON/OFF schedule"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Automatically wake and turn off the screen"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/editScreenOnTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Wake at (HH:mm)"
                android:inputType="time"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/editScreenOffTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Turn off at (HH:mm)"
                android:inputType="time"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The display is physically off outside the ON–OFF window. Example: wake at 06:00 and turn off at 23:00 keeps it off overnight."
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Home Assistant MQTT Integration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home Assistant MQTT"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchMqttEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable MQTT + automatic HA discovery"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editMqttBrokerHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MQTT broker host (e.g. 192.168.1.10)"
            android:inputType="textUri"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editMqttBrokerPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MQTT port (default 1883)"
            android:inputType="number"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editMqttUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MQTT username"
            android:inputType="textNoSuggestions"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="#FF2A2A2A"
            app:boxBackgroundMode="filled"
            app:endIconMode="password_toggle"
            app:endIconTint="#FFB0B0B0"
            app:hintTextColor="#FF808080">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editMqttPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="MQTT password"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080" />

        </com.google.android.material.textfield.TextInputLayout>

        <EditText
            android:id="@+id/editMqttDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Device name in Home Assistant"
            android:inputType="textCapWords"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editMqttDiscoveryPrefix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Discovery prefix (default homeassistant)"
            android:inputType="textNoSuggestions"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publishes a retained MQTT Discovery light with ON/OFF, brightness and availability. No HA token or YAML helpers required."
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Settings PIN -->
        <EditText
            android:id="@+id/editPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Settings PIN"
            android:inputType="numberPassword"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Debug Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debug Info"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textDebugInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Exit kiosk -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitKiosk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exit Kiosk Mode"
            android:textColor="#FFFF5252"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
