<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="24sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Dashboard URLs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_urls_label"
            android:labelFor="@id/editDashboardUrls"
            android:textColor="#FFB0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editDashboardUrls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine|textUri"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_allowed_origins_label"
            android:labelFor="@id/editDashboardAllowedOrigins"
            android:textColor="#FFB0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editDashboardAllowedOrigins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top"
            android:inputType="textMultiLine|textUri"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_allowed_origins_help"
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Auto-rotate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoRotate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auto_rotate_dashboards"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <EditText
            android:id="@+id/editAutoRotateInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/rotate_interval_hint"
            android:inputType="number"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Scheduled Content -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/content_schedule_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchContentSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/content_schedule_enabled"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editContentProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="4"
            android:gravity="top"
            android:hint="@string/content_profiles_hint"
            android:inputType="textMultiLine|textUri"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/content_schedule_help"
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Idle Screen -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/idle_screen_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchIdleScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/idle_screen_enabled"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editIdleScreenUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/idle_screen_url_hint"
            android:inputType="textUri"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editIdleTimeoutMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/idle_timeout_hint"
            android:inputType="number"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/idle_screen_help"
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Brightness -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brightness_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_brightness_label"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editMinBrightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/min_brightness_hint"
                android:inputType="number"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/editMaxBrightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/max_brightness_hint"
                android:inputType="number"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Screen Schedule -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_schedule_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_schedule_enabled"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/editScreenOnTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/wake_at_hint"
                android:inputType="time"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/editScreenOffTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/turn_off_at_hint"
                android:inputType="time"
                android:background="#FF2A2A2A"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080"
                android:padding="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_schedule_help"
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Home Assistant MQTT Integration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mqtt_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchMqttEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mqtt_enabled_label"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editMqttBrokerHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mqtt_host_hint"
            android:inputType="textUri"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editMqttBrokerPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mqtt_port_hint"
            android:inputType="number"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editMqttUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mqtt_username_hint"
            android:inputType="textNoSuggestions"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="#FF2A2A2A"
            app:boxBackgroundMode="filled"
            app:endIconMode="password_toggle"
            app:endIconTint="#FFB0B0B0"
            app:hintTextColor="#FF808080">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editMqttPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/mqtt_password_hint"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF808080" />

        </com.google.android.material.textfield.TextInputLayout>

        <EditText
            android:id="@+id/editMqttDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mqtt_device_name_hint"
            android:inputType="textCapWords"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editMqttDiscoveryPrefix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mqtt_discovery_prefix_hint"
            android:inputType="textNoSuggestions"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mqtt_help"
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Remote configuration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remote_config_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchRemoteConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_config_enabled_label"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textRemoteConfigAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0B0B0"
            android:textSize="13sp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_config_security_help"
            android:textColor="#FFFFC107"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Settings PIN -->
        <EditText
            android:id="@+id/editPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_pin_hint"
            android:inputType="numberPassword"
            android:background="#FF2A2A2A"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF808080"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF404040"
            android:layout_marginBottom="16dp" />

        <!-- Debug Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debug_info_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textDebugInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0B0B0"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Exit kiosk -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitKiosk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exit_kiosk_mode"
            android:textColor="#FFFF5252"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
